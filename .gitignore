.DS_Store

# Internal review and audit work products
.review/
*AUDIT*.md
audit-round*.md
CODE_REVIEW_*.md

# SwiftPM / local build output
.build/
build/
.swiftpm/

# 本地构建号（scripts/build-app.sh 自动递增，随构建频繁变化，不再入库）
.build_number
.build_number.tmp.*

# Packaged app artifacts
*.app
*.dmg

# Local temporary/debug dirs
.codex-tmp/
.zcode/
/.worktrees/

# Personal working notes (audit execution plans, scratch plans, etc.).
# `docs/plans/` would otherwise risk being tracked accidentally; the explicit
# pattern prevents surprise inclusion of any future planning markdown.
docs/plans/

# Python tooling leftovers
__pycache__/
*.pyc

# Editor temp files
*.swp
*.swo
